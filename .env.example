TELEGRAM_BOT_TOKEN=put-telegram-token-here

# OpenAI-compatible settings
OPENAI_API_KEY=put-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional (leave empty for default OpenAI): https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_INSECURE_SKIP_VERIFY=0

# Context folder with FAQ/регламенты/каталог клиник etc.
CONTEXT_DIR=context

# How many last messages to keep per chat
HISTORY_LIMIT=10

# Max chars of context stuffed into prompt
CONTEXT_CHAR_LIMIT=35000

# If Telegram API TLS fails due to corporate proxy CA, set to 1 (dev only).
TELEGRAM_INSECURE_SKIP_VERIFY=0

# --- Supabase RAG (scripts/index_knowledge.py) ---
SUPABASE_URL=
# Service role key (для очистки таблицы и вставки; не используйте anon в проде)
SUPABASE_SERVICE_KEY=

# Опционально для индексации
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
SUPABASE_TABLE=documents
SUPABASE_MATCH_RPC=match_documents
INDEX_BATCH_SIZE=80
SUPABASE_POSTGREST_TIMEOUT=300

# Только если TLS к Supabase/OpenAI падает с CERTIFICATE_VERIFY_FAILED (корпоративная сеть):
SUPABASE_INSECURE_SKIP_VERIFY=0
# Совместимо с переменной для Telegram; для эмбеддингов OpenAI при индексации:
OPENAI_INSECURE_SKIP_VERIFY=0

# Очистку таблицы через API не вызывать (таблицу очистить вручную: TRUNCATE documents;):
SKIP_SUPABASE_TRUNCATE=0

# --- RAG в боте (bot/main.py) ---
RAG_ENABLED=1
RAG_TOP_K=6
